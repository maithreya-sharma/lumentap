{
  "name": "LumenTap",
  "short_name": "LumenTap",
  "description": "Tap any spot on a photo to re-expose the whole image around it.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
